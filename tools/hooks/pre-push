#!/usr/bin/env bash
# Scan the commits about to be pushed (messages and diffs) plus the tree. Installed by tools/install-hooks.sh.
cd "$(git rev-parse --show-toplevel)" || exit 1
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue   # deleting a ref
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  tools/privacy-scan.sh --range "$range" || status=1
done
[ $status -eq 0 ] || { echo "pre-push: blocked by privacy-scan"; exit 1; }
exit 0
